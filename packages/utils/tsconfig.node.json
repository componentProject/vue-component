{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": true
  },
  "exclude": [
    "node_modules",
    "moluoxixi",
    "typings",
    "_scripts"
  ]
}
