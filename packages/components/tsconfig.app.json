{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.vue"
  ],
  "vueCompilerOptions": {
    "plugins": [
      "@vue-macros/volar/define-models",
      "@vue-macros/volar/define-slots",
      "@vue-macros/volar/define-props",
      "@vue-macros/volar/define-emits"
    ]
  },
  "exclude": [
    "dist",
    "node_modules",
    "_scripts/**/*"
  ]
}
