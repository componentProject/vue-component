{
  "workspaces": [
    "packages/*",
    "play/*",
    "docs/*"
  ],
  "type": "module",
  "version": "1.3.1",
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "readme": "README.md",
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "author": "1983531544@qq.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+http://192.168.18.106/middle-tec/front-web/vue-component.git"
  },
  "keywords": [
    "element-plus",
    "ElementPlus",
    "vue",
    "vite",
    "vue3",
    "ts",
    "eslint",
    "commitlint",
    "husky",
    "lint-staged",
    "typescript",
    "vite",
    "pinia",
    "router",
    "sass",
    "tailwindcss",
    "template"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "submodule:update": "git submodule update --init --recursive --remote",
    "postinstall": "pnpm run submodule:update",
    "vue:dev": "pnpm run -C play/render dev",
    "vue:build": "pnpm run -C play/render build",
    "docs:dev": "pnpm run -C docs/vitepress dev",
    "docs:build": "pnpm run -C docs/vitepress build",
    "storybook:dev": "pnpm run -C docs/storybook build",
    "storybook:build": "pnpm run -C docs/storybook build",
    "components:build": "pnpm run -C packages/components build",
    "components:publish": "pnpm run -C packages/components publish",
    "element:build": "pnpm run -C packages/ElementPlus build",
    "element:publish": "pnpm run -C packages/ElementPlus publish",
    "utils:build": "pnpm run -C packages/utils build",
    "utils:publish": "pnpm run -C packages/utils publish",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "prepare": "node .husky/install.mjs",
    "lint-staged": "lint-staged",
    "commit": "git-cz",
    "remove-comments": "tsx scripts/removeComments.mts && eslint --fix"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@antfu/eslint-config": "catalog:dev",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@vue-macros/volar": "catalog:dev",
    "ant-design-vue": "^4.2.6",
    "commitizen": "catalog:dev",
    "compressing": "catalog:dev",
    "cz-customizable": "catalog:dev",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "husky": "catalog:dev",
    "lint-staged": "catalog:dev",
    "npm-run-all2": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev",
    "vite": "catalog:dev"
  },
  "lint-staged": {
    "*.{jsx,tsx,js,ts,vue,css,scss,less}": [
      "eslint --fix"
    ]
  }
}
