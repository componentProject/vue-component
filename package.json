{
  "workspaces": [
    "packages/*",
    "play/*",
    "docs/*"
  ],
  "private": true,
  "packageManager": "pnpm@10.8.0",
  "version": "1.3.1",
  "engines": {
    "node": ">=20.18.0"
  },
  "type": "module",
  "readme": "README.md",
  "scripts": {
    "vue:dev": "pnpm run -C play/render dev",
    "vue:build": "pnpm run -C play/render build",
    "docs:dev": "pnpm run -C docs/vitepress dev",
    "docs:build": "pnpm run -C docs/vitepress build",
    "storybook:dev": "pnpm run -C docs/storybook build",
    "storybook:build": "pnpm run -C docs/storybook build",
    "components:build": "pnpm run -C packages/components build",
    "components:publish": "pnpm run -C packages/components publish",
    "utils:build": "pnpm run -C packages/utils build",
    "utils:publish": "pnpm run -C packages/utils publish",
    "type-check": "vue-tsc --build",
    "lint-check": "eslint --inspect-config",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "lint-staged": "lint-staged",
    "commit": "git-cz"
  },
  "lint-staged": {
    "*.{vue,jsx,tsx}": [
      "eslint --fix"
    ],
    "*.{css,scss,less,vue,jsx,tsx}": [
      "stylelint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-customizable"
    },
    "cz-customizable": {
      "config": ".cz-config.cjs"
    }
  },
  "license": "MIT",
  "author": "1983531544@qq.com",
  "pnpm": {
    "packageExtensions": {
      "@moluoxixi/element-setters@*": {
        "dependencies": {
          "@moluoxixi/element-prototypes": "1.0.4"
        }
      }
    },
    "overrides": {
      "@moluoxixi/element-prototypes": "1.0.4",
      "@moluoxixi/element-renderer": "1.0.4",
      "@moluoxixi/element-settings-form": "1.0.4"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+http://192.168.18.106/middle-tec/front-web/vue-component.git"
  },
  "keywords": [
    "element-plus",
    "ElementPlus",
    "vue",
    "vite",
    "vue3",
    "ts",
    "eslint",
    "commitlint",
    "husky",
    "lint-staged",
    "typescript",
    "vite",
    "pinia",
    "router",
    "sass",
    "tailwindcss",
    "template"
  ],
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@vue-macros/volar": "catalog:dev",
    "commitizen": "^4.3.1",
    "compressing": "^1.10.1",
    "cz-customizable": "^7.4.0",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "npm-run-all2": "^7.0.2",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-less": "^3.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "tsx": "^4.20.5",
    "typescript": "catalog:dev",
    "vite": "catalog:dev"
  }
}
